# Généré par scripts/deploy.py — ne pas modifier sur le serveur.
{
	email romanmitridebmx@gmail.com
}

(site) {
	root * /var/www/romanmitride/current
	encode zstd gzip

	# /page.html -> /page (sauf l'URL figée de l'application OAuth et la 404)
	@html {
		path_regexp html ^(.+)\.html$
		not path /confidentialite.html /404.html
	}
	redir @html {re.html.1} permanent

	try_files {path} {path}.html {path}/index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "__CSP__"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		-Server
	}
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@media path /media/*
	header @media Cache-Control "public, max-age=604800"

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

__SITES__
