---
const liens = [
  { href: '/#a-propos', label: 'À propos' },
  { href: '/#prestations', label: 'Prestations' },
  { href: '/#galerie', label: 'Galerie' },
  { href: '/faq', label: 'FAQ' },
];
---
<header class="fixed inset-x-0 top-0 z-40 px-4 pt-4">
  <nav aria-label="Navigation principale" class="liquid-glass mx-auto flex max-w-5xl items-center justify-between rounded-full py-2.5 pl-6 pr-2.5">
    <a href="/" class="font-display text-lg text-texte" data-umami-event="nav" data-umami-event-cible="accueil">Roman Mitride</a>
    <ul class="hidden items-center gap-7 text-sm md:flex">
      {liens.map((l) => (
        <li><a href={l.href} class="text-texte/80 transition-colors hover:text-texte" data-umami-event="nav" data-umami-event-cible={l.label}>{l.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a href="/#devis" class="btn-accent !px-5 !py-2.5 text-sm" data-umami-event="devis-clic" data-umami-event-emplacement="nav"><span class="sm:hidden">Devis</span><span class="hidden sm:inline">Demander un devis</span></a>
      <details class="relative md:hidden">
        <summary class="liquid-glass flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-48 rounded-2xl bg-surface p-3 text-sm shadow-xl ring-1 ring-ligne">
          {liens.map((l) => (
            <li><a href={l.href} class="block rounded-lg px-3 py-2 hover:bg-fond" data-umami-event="nav" data-umami-event-cible={l.label}>{l.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>
