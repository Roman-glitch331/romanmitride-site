---
// Téléphone et e-mail encodés dans le HTML (les robots ne les lisent pas en clair), rendus cliquables par Base.astro.
import { identite } from '../content/site';

interface Props { emplacement: string }
const { emplacement } = Astro.props;
const enc = (s: string) => Buffer.from(s).toString('base64');
const sujet = encodeURIComponent('Demande de devis – BMX Flatland');
const corps = encodeURIComponent(
  'Bonjour Roman,\n\nPrestation souhaitée (show solo, show duo, initiation, tournage) :\nDate :\nLieu :\nNombre de personnes attendues :\n\nMerci !'
);
---
<div class="flex flex-wrap gap-3">
  <a href="#devis" data-c={enc(identite.telephone)} class="btn-accent" data-umami-event="appel-clic" data-umami-event-emplacement={emplacement}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
    Appeler <span data-label class="sr-only md:not-sr-only">le numéro</span>
  </a>
  <a href="#devis" data-c={enc(identite.email)} data-q={`?subject=${sujet}&body=${corps}`} class="liquid-glass btn-glass" data-umami-event="email-clic" data-umami-event-emplacement={emplacement}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
    <span data-label>Envoyer un e-mail</span>
  </a>
</div>
<noscript><p class="mt-3 text-sm text-attenue">E-mail : romanmitridebmx [arobase] gmail [point] com</p></noscript>
