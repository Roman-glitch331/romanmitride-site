---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { faq } from '../content/site';

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.filter((f) => !f.r.startsWith('[À compléter')).map((f) => ({
    '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
}];
---
<Base title="Questions fréquentes : show et initiation BMX Flatland · Roman Mitride"
  description="Tarif d’un show BMX, durée, installation, déplacements, initiation : les réponses aux questions des organisateurs d’événements."
  jsonld={jsonld}>
  <main class="mx-auto max-w-3xl px-6 pt-36">
    <p class="kicker animate-fade-rise">FAQ</p>
    <h1 class="font-display mt-3 text-4xl md:text-6xl animate-fade-rise">Questions fréquentes</h1>
    <p class="mt-5 text-lg text-texte/85 animate-fade-rise-1">Tout ce que les organisateurs me demandent avant de réserver un show ou une initiation de BMX Flatland.</p>
    <div class="mt-10 divide-y divide-ligne border-y border-ligne">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium">
            <h2>{f.q}</h2>
            <span aria-hidden="true" class="text-accent transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-texte/85">{f.r} <a href={f.lien} class="text-accent underline">En savoir plus</a></p>
        </details>
      ))}
    </div>
    <div class="mt-12">
      <p class="mb-4 text-texte/85">Votre question n’y est pas ? Le plus simple, c’est d’en parler de vive voix.</p>
      <ContactLinks emplacement="faq" />
    </div>
  </main>
</Base>
