---
import '../styles/global.css';
import { identite } from '../content/site';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
    <footer class="mx-auto max-w-5xl px-6 py-10 text-sm text-attenue">
      <p>© {new Date().getFullYear()} {identite.nom} · BMX Flatland Pau</p>
      <p class="mt-2">
        Ce site présente aussi les outils personnels « Deneb » et « BMX Flatland Prospector » utilisés par Roman MITRIDE.
      </p>
      <nav class="mt-3 flex flex-wrap gap-4" aria-label="Liens légaux">
        <a href="/mentions-legales" class="underline">Mentions légales</a>
        <a href="/confidentialite.html" class="underline">Règles de confidentialité</a>
      </nav>
    </footer>
  </body>
</html>
